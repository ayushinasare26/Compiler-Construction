%%
"for"       { return FOR; }
"("         { return LPAREN; }
")"         { return RPAREN; }
"{"         { return LBRACE; }
"}"         { return RBRACE; }
";"         { return SEMICOLON; }
"="         { return ASSIGN; }
[a-zA-Z]+   { return IDENTIFIER; }
[0-9]+      { return NUMBER; }
[ \t\n]+    ;  /* Skip whitespace */
.           { printf("Invalid character: %s\n", yytext); }
