#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void yyerror(char *s);
int yylex(void);

int temp = 0;

char* newTemp()
{
    char *t = malloc(10);
    sprintf(t, "t%d", temp++);
    return t;
}
%}

%union {
    int num;
    char *code;
}

%token <num> NUMBER
%type <code> expr

%left '+' '-'
%left '*' '/'

%%

program:
    expr '\n'
    {
        printf("\nThree Address Code:\n%s\n", $1);
    }
    ;

expr:
    NUMBER
    {
        char *t = newTemp();
        $$ = malloc(50);
        sprintf($$, "%s = %d", t, $1);
    }
    | expr '+' expr
    {
        char *t = newTemp();
        $$ = malloc(strlen($1) + strlen($3) + 50);
        sprintf($$, "%s\n%s\n%s = %s + %s",
                $1, $3, t, $1, $3);
    }
    | expr '-' expr
    {
        char *t = newTemp();
        $$ = malloc(strlen($1) + strlen($3) + 50);
        sprintf($$, "%s\n%s\n%s = %s - %s",
                $1, $3, t, $1, $3);
    }
    | expr '*' expr
    {
        char *t = newTemp();
        $$ = malloc(strlen($1) + strlen($3) + 50);
        sprintf($$, "%s\n%s\n%s = %s * %s",
                $1, $3, t, $1, $3);
    }
    | expr '/' expr
    {
        char *t = newTemp();
        $$ = malloc(strlen($1) + strlen($3) + 50);
        sprintf($$, "%s\n%s\n%s = %s / %s",
                $1, $3, t, $1, $3);
    }
    | '(' expr ')'
    {
        $$ = $2;
    }
    ;

%%

void yyerror(char *s)
{
    fprintf(stderr, "Error: %s\n", s);
}

int main(void)
{
    printf("Enter an arithmetic expression:\n");
    yyparse();
    return 0;
}